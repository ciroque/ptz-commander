#include "ptz_version.h"

IDI_ICON1 ICON "ptz-commander.ico"

// Resource id 1. version.dll looks up RT_VERSION by integer id, not by the
// VS_VERSION_INFO token, and this rc invocation does not include winver.h.
1 VERSIONINFO
 FILEVERSION PTZ_VERSION_MAJOR,PTZ_VERSION_MINOR,PTZ_VERSION_PATCH,PTZ_VERSION_BUILD
 PRODUCTVERSION PTZ_VERSION_MAJOR,PTZ_VERSION_MINOR,PTZ_VERSION_PATCH,PTZ_VERSION_BUILD
 FILEFLAGSMASK 0x3fL
#if PTZ_VERSION_IS_RELEASE
 FILEFLAGS 0x0L
#else
 FILEFLAGS 0x8L
#endif
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "PTZ Commander Project"
            VALUE "FileDescription", "Command-line tool for controlling PTZ cameras"
            VALUE "FileVersion", PTZ_VERSION_STRING
            VALUE "InternalName", "ptz_commander.exe"
            VALUE "OriginalFilename", "ptz_commander.exe"
            VALUE "ProductName", "PTZ Commander"
            VALUE "ProductVersion", PTZ_VERSION_STRING
#if !PTZ_VERSION_IS_RELEASE
            VALUE "PrivateBuild", PTZ_VERSION_STRING
#endif
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
