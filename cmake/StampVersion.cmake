# Resolves one product version and writes:
#   ${PTZ_BINARY_DIR}/generated/ptz_version.h
#   ${PTZ_BINARY_DIR}/ptz_product_version.txt   (WiX four-part X.Y.Z.W)
#
# Order: PTZ_VERSION / PTZ_VERSION_OVERRIDE, else a vX.Y.Z GITHUB_REF_NAME
# when GITHUB_ACTIONS=true (shallow tag checkouts have no describe tag),
# else `git describe --tags --always --dirty`.
#
# A release tag vX.Y.Z becomes display X.Y.Z and MSI X.Y.Z.0.
# Describe vX.Y.Z-N-gHASH becomes display X.Y.Z-N-gHASH and MSI X.Y.Z.N.
# Anything else is not a release: display text kept, MSI 0.0.0.0.

function(ptz_stamp_version)
    if(NOT PTZ_SOURCE_DIR OR NOT PTZ_BINARY_DIR)
        message(FATAL_ERROR "PTZ_SOURCE_DIR and PTZ_BINARY_DIR must be set")
    endif()

    set(raw "")
    if(DEFINED PTZ_VERSION_OVERRIDE AND NOT "${PTZ_VERSION_OVERRIDE}" STREQUAL "")
        set(raw "${PTZ_VERSION_OVERRIDE}")
    elseif(DEFINED PTZ_VERSION AND NOT "${PTZ_VERSION}" STREQUAL "")
        set(raw "${PTZ_VERSION}")
    endif()

    if("${raw}" STREQUAL "" AND "$ENV{GITHUB_ACTIONS}" STREQUAL "true")
        set(gh_ref "$ENV{GITHUB_REF_NAME}")
        if(gh_ref MATCHES "^[vV][0-9]+\\.[0-9]+\\.[0-9]+$")
            set(raw "${gh_ref}")
        endif()
    endif()

    if("${raw}" STREQUAL "")
        find_package(Git QUIET)
        if(GIT_FOUND)
            execute_process(
                COMMAND "${GIT_EXECUTABLE}" describe --tags --always --dirty
                WORKING_DIRECTORY "${PTZ_SOURCE_DIR}"
                OUTPUT_VARIABLE raw
                OUTPUT_STRIP_TRAILING_WHITESPACE
                ERROR_QUIET
                RESULT_VARIABLE git_rc
            )
            if(NOT (git_rc EQUAL 0))
                set(raw "")
            endif()
        endif()
    endif()

    set(has_semver 0)
    set(is_release 0)
    set(dirty 0)
    set(commits 0)
    set(major 0)
    set(minor 0)
    set(patch 0)
    set(build_num 0)

    if("${raw}" STREQUAL "")
        set(display "unknown")
    else()
        set(display "${raw}")
        if(display MATCHES "^[vV][0-9]")
            string(REGEX REPLACE "^[vV]" "" display "${display}")
        endif()
        if(NOT display MATCHES "^[0-9A-Za-z.+_-]+$")
            set(display "unknown")
        endif()
    endif()

    if(NOT ("${display}" STREQUAL "unknown"))
        set(core "${display}")
        if(core MATCHES "-dirty$")
            set(dirty 1)
            string(REGEX REPLACE "-dirty$" "" core "${core}")
        endif()

        if(core MATCHES "^([0-9]+)\\.([0-9]+)\\.([0-9]+)$")
            set(major "${CMAKE_MATCH_1}")
            set(minor "${CMAKE_MATCH_2}")
            set(patch "${CMAKE_MATCH_3}")
            set(has_semver 1)
            if(NOT dirty)
                set(is_release 1)
            endif()
        elseif(core MATCHES "^([0-9]+)\\.([0-9]+)\\.([0-9]+)-([0-9]+)-g[0-9a-fA-F]+$")
            set(major "${CMAKE_MATCH_1}")
            set(minor "${CMAKE_MATCH_2}")
            set(patch "${CMAKE_MATCH_3}")
            set(commits "${CMAKE_MATCH_4}")
            set(build_num "${commits}")
            set(has_semver 1)
        endif()
    endif()

    foreach(part IN ITEMS major minor patch build_num)
        if(${part} GREATER 65535)
            set(${part} 65535)
        endif()
    endforeach()

    set(msi "${major}.${minor}.${patch}.${build_num}")
    if(has_semver)
        set(product "${major}.${minor}.${patch}")
    else()
        set(product "unknown")
    endif()

    set(header_text
"#ifndef PTZ_VERSION_H
#define PTZ_VERSION_H

/* Generated by cmake/StampVersion.cmake. Do not edit. */

#define PTZ_VERSION_STRING \"${display}\"
#define PTZ_VERSION_PRODUCT \"${product}\"
#define PTZ_VERSION_MAJOR ${major}
#define PTZ_VERSION_MINOR ${minor}
#define PTZ_VERSION_PATCH ${patch}
#define PTZ_VERSION_BUILD ${build_num}
#define PTZ_VERSION_COMMITS ${commits}
#define PTZ_VERSION_HAS_SEMVER ${has_semver}
#define PTZ_VERSION_IS_RELEASE ${is_release}
#define PTZ_VERSION_DIRTY ${dirty}

#endif
")

    file(MAKE_DIRECTORY "${PTZ_BINARY_DIR}/generated")
    set(header_path "${PTZ_BINARY_DIR}/generated/ptz_version.h")
    set(header_tmp "${header_path}.tmp")
    file(WRITE "${header_tmp}" "${header_text}")
    execute_process(COMMAND "${CMAKE_COMMAND}" -E copy_if_different "${header_tmp}" "${header_path}")
    file(REMOVE "${header_tmp}")

    set(version_txt "${PTZ_BINARY_DIR}/ptz_product_version.txt")
    set(version_tmp "${version_txt}.tmp")
    file(WRITE "${version_tmp}" "${msi}\n")
    execute_process(COMMAND "${CMAKE_COMMAND}" -E copy_if_different "${version_tmp}" "${version_txt}")
    file(REMOVE "${version_tmp}")

    message(STATUS "PTZ Commander version: ${display} (msi ${msi})")

    set(PTZ_VERSION_STRING "${display}" PARENT_SCOPE)
    set(PTZ_VERSION_MAJOR "${major}" PARENT_SCOPE)
    set(PTZ_VERSION_MINOR "${minor}" PARENT_SCOPE)
    set(PTZ_VERSION_PATCH "${patch}" PARENT_SCOPE)
    set(PTZ_VERSION_MSI "${msi}" PARENT_SCOPE)
endfunction()

if(CMAKE_SCRIPT_MODE_FILE)
    ptz_stamp_version()
endif()
